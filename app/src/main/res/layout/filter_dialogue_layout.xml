<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/white"

    >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="8dp">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filters"
            android:textColor="@color/black"
            android:textSize="36dp"
            android:layout_margin="8dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/filter_chip_cont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:alignItems="stretch"
            app:flexDirection="row"
            android:layout_margin="8dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintBottom_toTopOf="@id/order_filter_cancel"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/order_filter_clear"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Clear All"
            android:layout_margin="8dp"
            android:textColor="@color/black"
            android:background="@drawable/outlined_view"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/order_filter_cancel"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:text="Cancel"
            android:shadowColor="@color/white"
            android:layout_margin="8dp"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"

            app:layout_constraintEnd_toStartOf="@+id/order_filter_apply" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/order_filter_apply"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:textAllCaps="false"
            android:text="Apply"
            android:textColor="@color/black"
            android:layout_margin="8dp"
            android:background="@drawable/order_tab_indicator"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.cardview.widget.CardView>